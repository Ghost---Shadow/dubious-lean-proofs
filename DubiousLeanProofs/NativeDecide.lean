/-!
# 6. Lying to the compiler

`native_decide` evaluates a decision procedure with compiled code instead of
the kernel. `@[implemented_by]` swaps a definition's compiled code for another
function, and nothing checks that the two agree. Together they prove `False`.
-/

namespace NativeDecide

def fakeAnswer : Nat := 0

/-- Logically `answer = 1`, but compiled code runs `fakeAnswer` instead. -/
@[implemented_by fakeAnswer]
def answer : Nat := 1

theorem answer_eq_one : answer = 1 := rfl

theorem answer_eq_zero : answer = 0 := by native_decide

theorem oops : False := absurd (answer_eq_one.symm.trans answer_eq_zero) (by decide)

/-! How to catch it: the proof depends on an auxiliary axiom generated by
`native_decide` (`answer_eq_zero._native.native_decide.ax_…`), which says
"trust the compiler". -/
/-- info: 'NativeDecide.oops' depends on axioms: [answer_eq_zero._native.native_decide.ax_1_1] -/
#guard_msgs in
#print axioms oops

end NativeDecide
